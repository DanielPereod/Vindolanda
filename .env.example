POSTGRES_DB=personal_life
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:55432/personal_life?sslmode=disable
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
INITIAL_USERNAME=owner
# Optional: identifies this installation to Open Food Facts (a contact is appreciated).
# OPENFOODFACTS_USER_AGENT=personal-life/0.1 (you@example.com)
# Optional: set INITIAL_PASSWORD here (12–72 bytes) or leave unset to be prompted by `make provision`.
# INITIAL_PASSWORD=change-me-to-12-plus-bytes

# --- Self-hosting with compose.prod.yaml -----------------------------------
# Create this file next to compose.prod.yaml on your server and set, at least,
# POSTGRES_PASSWORD and APP_ORIGIN. The database URL for self-hosting is built
# by the compose file, so the DATABASE_URL line above is only for local use.
#
# POSTGRES_PASSWORD=use-a-long-random-password
# APP_ORIGIN=http://192.168.1.50:8090   # exact URL the browser uses
#
# The image tags, the published port (8090), COOKIE_SECURE and the other
# settings are literal inside compose.prod.yaml; edit that file to pin a
# version, change the port or enable HTTPS cookies.
